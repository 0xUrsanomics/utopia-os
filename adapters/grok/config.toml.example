# Utopia OS MCP servers for grok (xAI grok CLI).
# Copy into ~/.grok/config.toml (or .grok/config.toml per-project). Same [mcp_servers.*]
# shape as Codex. Replace /path/to placeholders. Do NOT inline real tokens in the
# env table; source them from the environment / a secret manager.

# NOT SHIPPED. utopia-os does not include a memory MCP server; this entry is left here as the slot to fill. Build one exposing your Markdown memory + SSOT, using scripts/mcp/telegram_bridge.py as the shape and knowledge/mcp-builder-reference/ as the guide. Re-enable this block once it exists.
# [mcp_servers.memory]
# command = "python3"
# args = ["/path/to/utopia-os/scripts/memory/memory_server.py"]
# enabled = true

[mcp_servers.recall]
command = "python3"
args = ["/path/to/utopia-os/scripts/memory/vector_brain.py", "serve"]
enabled = true

[mcp_servers.telegram]
command = "python3"
args = ["/path/to/utopia-os/scripts/mcp/telegram_bridge.py"]
# token comes from the environment; do not paste it here
env = { TELEGRAM_BOT_TOKEN = "", TELEGRAM_ALLOWED_CHAT_IDS = "" }
startup_timeout_sec = 30

# example remote HTTP server
# [mcp_servers.daemon_http]
# url = "https://your-daemon.example/mcp"
# headers = { "x-mcp-session-id" = "{{session_id}}" }

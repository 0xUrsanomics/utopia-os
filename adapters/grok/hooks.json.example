{
  "_comment": "Utopia OS guardrail + hygiene hooks for grok. grok uses the Claude Code settings.json hooks JSON format, so this is a near-verbatim port of settings.example.json. Copy to ~/.grok/hooks/utopia.json (or reuse ~/.claude/settings.json via grok's compat mode). Replace /path/to/utopia-os with your checkout. NOTE: grok stdin fields are camelCase (toolName/hookEventName); guardrail scripts that parse stdin must accept both camel + snake case. Confirm tool-name matchers against grok's tool names.",
  "hooks": {
    "SessionStart": [
      { "hooks": [
        { "type": "command", "command": "/path/to/utopia-os/scripts/memory/session_bootstrap.sh", "timeout": 600 }
      ]}
    ],
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "python3 /path/to/utopia-os/scripts/security/auto_compound_counter.py --reset" },
        { "type": "command", "command": "python3 /path/to/utopia-os/scripts/agents/bus_turn_poll.py" }
      ]}
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [
        { "type": "command", "command": "python3 /path/to/utopia-os/scripts/security/check_standdown.py --from-hook", "timeout": 10 }
      ]},
      { "matcher": "Read|Edit|Write", "hooks": [
        { "type": "command", "command": "python3 /path/to/utopia-os/scripts/security/skill_linter.py --from-hook" }
      ]}
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit|MultiEdit", "hooks": [
        { "type": "command", "command": "python3 /path/to/utopia-os/scripts/memory/verify_after_write.py --from-hook" }
      ]}
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "/path/to/utopia-os/scripts/security/reply_guard.sh" }
      ]}
    ]
  }
}

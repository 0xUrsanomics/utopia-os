# Utopia OS ships ZERO real content. This ignore is belt-and-suspenders; the
# repo is BUILT clean, not filtered. Never commit anything matching:
.env
*.env
*.bak
*.bak-*
*credentials*
*secret*
*token*
*.key
*.pem
__pycache__/
*.pyc
.DS_Store
# runtime/content dirs that must never exist here
outputs/
logs/
private/
refs/
# Runtime state. Everything under memory/state/ is generated at run time EXCEPT the
# *.example.* templates, which are the shipped scaffolds. Broadened 2026-07-28 after
# `ssot.py self-test` and `confirm_gate.py list` produced confirm_gate.db and
# active_persona.txt, neither of which the old *.sqlite rule caught.
memory/state/*
!memory/state/*.example.json
!memory/state/*.example.txt
.utopia-build/
.data/
